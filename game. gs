let balance = 1000;
let multiplier = 1.00;
let crashPoint;
let gameRunning = false;
let betAmount = 0;
let timer;

function placeBet() {
    if (gameRunning) return;

    betAmount = Number(document.getElementById("bet").value);

    if (betAmount <= 0 || betAmount > balance) {
        document.getElementById("message").innerText =
            "Invalid bet amount!";
        return;
    }

    balance -= betAmount;
    document.getElementById("balance").innerText = balance;

    multiplier = 1.00;

    // Demo ke liye random crash point
    crashPoint = (Math.random() * 5 + 1).toFixed(2);

    gameRunning = true;

    document.getElementById("betBtn").disabled = true;
    document.getElementById("cashBtn").disabled = false;
    document.getElementById("message").innerText = "Plane is flying...";

    timer = setInterval(runGame, 100);
}

function runGame() {
    multiplier += 0.05;

    document.getElementById("multiplier").innerText =
        multiplier.toFixed(2) + "x";

    if (multiplier >= crashPoint) {
        crashGame();
    }
}

function crashGame() {
    clearInterval(timer);

    gameRunning = false;

    document.getElementById("message").innerText =
        "💥 CRASHED at " + multiplier.toFixed(2) + "x";

    document.getElementById("betBtn").disabled = false;
    document.getElementById("cashBtn").disabled = true;
}

function cashOut() {
    if (!gameRunning) return;

    clearInterval(timer);

    let win = betAmount * multiplier;

    balance += Math.floor(win);

    document.getElementById("balance").innerText = balance;

    document.getElementById("message").innerText =
        "🎉 CASH OUT! You won " + Math.floor(win) + " coins";

    gameRunning = false;

    document.getElementById("betBtn").disabled = false;
    document.getElementById("cashBtn").disabled = true;
}